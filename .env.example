# ---------------------------------------------------------------------------
# CornFlow — конфигурация
#
# Без этих переменных приложение стартует в MOCK-режиме:
# данные лежат в localStorage, файлы — в IndexedDB браузера.
# Достаточно подставить URL и anon-ключ проекта Supabase — и приложение
# автоматически переключится на реальный бэкенд (auth + postgres + storage + realtime).
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Имя бакета Supabase Storage для файлов материалов (создаётся миграцией)
VITE_SUPABASE_BUCKET=materials

# Принудительно оставить mock-режим, даже если ключи заданы: true / false
VITE_FORCE_MOCK=false
